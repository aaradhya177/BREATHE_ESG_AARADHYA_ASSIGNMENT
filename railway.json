{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "python manage.py migrate --noinput && python manage.py seed_client",
    "startCommand": "sh -c 'exec gunicorn breathe.wsgi:application --bind 0.0.0.0:${PORT:-8000}'",
    "restartPolicyType": "ON_FAILURE"
  }
}
